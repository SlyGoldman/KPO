using System;
using System.IO;
using System.Text;
using System.Text.RegularExpressions;
using OfficeOpenXml;
using HtmlAgilityPack;

class Program
{
    static void Main(string[] args)
    {
        System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);

        string htmFilePath = @"путь до //Исходники//ОСТ1 11293-73 тип 2.HTM (любой файл htm)";
        
        // Получаем имя исходного файла без расширения
        string fileNameWithoutExtension = Path.GetFileNameWithoutExtension(htmFilePath);

        // Получаем каталог файла, если он существует, иначе используем текущую директорию
        string directoryPath = Path.GetDirectoryName(htmFilePath) ?? Directory.GetCurrentDirectory();
        
        // Создаем путь для выходного Excel файла с тем же именем
        string xlsxFilePath = Path.Combine(directoryPath, fileNameWithoutExtension + ".xlsx");

        var htmlDoc = new HtmlDocument();

        // Загружаем HTML файл
        using (var reader = new StreamReader(htmFilePath, Encoding.GetEncoding("windows-1251")))
        {
            htmlDoc.Load(reader);
        }

        using (var package = new ExcelPackage())
        {
            var worksheet = package.Workbook.Worksheets.Add("Sheet1");
            string pattern = @"^Конструкторский.*(ТУ Страница 1|Страница 1)$"; // Исходный паттерн для артефактов
            Regex regex = new Regex(pattern);

            // Регулярное выражение для идентификации артефактов
            string artifactPattern = @"\\Конструкторский\\(Крепежные изделия\\.*Страница 1|Радиоэлементы\\.*Страница 1|Отверстия сквозные продолговатые под крепежные детали ГОСТ 16030-70 Страница 1|!Импортные ЭРИ НТЦ\\.*Страница 1)";
            Regex artifactRegex = new Regex(artifactPattern);

            var tables = htmlDoc.DocumentNode.SelectNodes("//table");
            if (tables == null || tables.Count == 0)
            {
                Console.WriteLine("Не удалось найти таблицы в файле HTM");
                return;
            }

            int row = 1; // Счётчик строк для Excel

            foreach (var table in tables)
            {
                var rows = table.SelectNodes(".//tr");
                if (rows == null || rows.Count == 0)
                {
                    Console.WriteLine("Не найдено строк в данной таблице.");
                    continue;
                }

                // Добавляем первую строку
                var headerCells = rows[0].SelectNodes(".//th");
                if (headerCells != null)
                {
                    int headerCol = 1;
                    foreach (var th in headerCells)
                    {
                        worksheet.Cells[row, headerCol].Value = th.InnerText.Trim();
                        headerCol++;
                    }
                    row++; // Переходим на следующую строку после заголовка
                }

                // Обрабатываем остальные строки
                for (int i = 1; i < rows.Count; i++) // Начинаем с 1, чтобы пропустить заголовок
                {
                    var cells = rows[i].SelectNodes(".//td");
                    if (cells == null) continue;

                    int col = 1;
                    bool hasData = false; // Флаг, указывающий, была ли добавлена хотя бы одна ячейка
                    bool isArtifactRow = false; // Флаг, указывающий, содержит ли строка артефакт

                    foreach (var td in cells)
                    {
                        if (td == null || string.IsNullOrWhiteSpace(td.InnerText))
                        {
                            col++; // Увеличиваем, если ячейка пустая
                            continue;
                        }

                        string cellText = td.InnerText.Trim();

                        // Проверяем на наличие артефактов
                        if (artifactRegex.IsMatch(cellText))
                        {
                            Console.WriteLine($"Удалено: {cellText}"); // Логирование удаленной строки
                            isArtifactRow = true; // Эта строка содержит артефакт
                            break; // Прерываем цикл, если артефакт найден
                        }
                        else
                        {
                            worksheet.Cells[row, col].Value = cellText; // Записываем значение в ячейку
                            hasData = true; // Отметим, что были добавлены данные
                        }

                        col++; // Увеличиваем счётчик столбцов для Excel
                    }

                    // Если строка не содержит артефакты и добавлены данные, увеличиваем счётчик строк
                    if (hasData && !isArtifactRow)
                    {
                        row++; // Переходим на следующую строку для записи данных
                    }
                }
            }

            // Удаляем пустые колонки
            int lastColumn = worksheet.Dimension.End.Column;
            for (int col = lastColumn; col >= 1; col--)
            {
                bool isEmptyColumn = true;
                for (int r = 1; r <= worksheet.Dimension.End.Row; r++)
                {
                    if (worksheet.Cells[r, col].Value != null && worksheet.Cells[r, col].Value.ToString() != string.Empty)
                    {
                        isEmptyColumn = false;
                        break;
                    }
                }

                if (isEmptyColumn)
                {
                    worksheet.DeleteColumn(col);
                }
            }

            ///////////////// Проверка и объединение колонок по условию - не видит и не слышит этот код, чтобы все выравнивалось ////////////////////////
            for (int col = 1; col < worksheet.Dimension.End.Column; col++)
            {
                // Проверяем, есть ли жирный текст в колонке
                bool hasBoldTextInColumn = false;
                for (int rowIdx = 1; rowIdx <= worksheet.Dimension.End.Row; rowIdx++)
                {
                    var cell = worksheet.Cells[rowIdx, col];
                    if (cell.Style.Font.Bold)
                    {
                        hasBoldTextInColumn = true;
                        break; // Прерываем цикл, если нашли жирный текст
                    }
                }

                // Проверяем, есть ли хотя бы 3 пустых строки в соседней колонке
                int emptyRowCount = 0;
                for (int rowIdx = 1; rowIdx <= worksheet.Dimension.End.Row; rowIdx++)
                {
                    var cell = worksheet.Cells[rowIdx, col + 1];
                    if (cell.Value == null || string.IsNullOrWhiteSpace(cell.Value.ToString()))
                    {
                        emptyRowCount++;
                    }
                    else
                    {
                        break; // Прерываем цикл, если встретили непустую строку
                    }
                }

                // Если в текущей колонке есть жирный текст и в соседней колонке хотя бы 3 пустых строки
                if (hasBoldTextInColumn && emptyRowCount >= 3)
                {
                    worksheet.Cells[1, col, worksheet.Dimension.End.Row, col + 1].Merge = true;
                    worksheet.DeleteColumn(col + 1); // Удаляем соседнюю колонку
                    col--; // Потому что мы удалили колонку, необходимо откатить счетчик на 1
                }
            }

            // Добавляем фильтры для заголовков в первой строке
            worksheet.Cells[1, 1, 1, worksheet.Dimension.End.Column].AutoFilter = true;

            // Устанавливаем жирный шрифт для заголовков
            for (int col = 1; col <= worksheet.Dimension.End.Column; col++)
            {
                worksheet.Cells[1, col].Style.Font.Bold = true; // Делаем текст в первой строке жирным
            }

            worksheet.Cells.AutoFitColumns(); // Автоматически подгоняем ширину столбцов

            // Сохраняем файл Excel с тем же именем, что и исходный HTML
            FileInfo excelFile = new FileInfo(xlsxFilePath);
            package.SaveAs(excelFile);
        }

        Console.WriteLine("Конвертация завершена!");
    }
}
